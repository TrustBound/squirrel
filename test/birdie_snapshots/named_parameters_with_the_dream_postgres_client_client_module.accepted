//// > a fork of Squirrel.
////

import dream_postgres_client as pog
import gleam/dynamic/decode

/// A row you get from running the `query` query
/// defined in `query.sql`.
///
/// > 🐿️ This type definition was generated automatically using v-test of the
/// > [dream_sql_generator package](https://github.com/TrustBound/squirrel/tree/dream-sql-generator),
/// > a fork of Squirrel.
///
pub type QueryRow {
  QueryRow(name: String)
}

/// Runs the `query` query
/// defined in `query.sql`.
///
/// > 🐿️ This function was generated automatically using v-test of
/// > the [dream_sql_generator package](https://github.com/TrustBound/squirrel/tree/dream-sql-generator),
/// > a fork of Squirrel.
///
pub fn query(
  connection: pog.Connection,
  squirrel_user_id: Int,
  squirrel_user_name: String,
) -> Result(pog.Returned(QueryRow), pog.QueryError) {
  let decoder = {
    use name <- decode.field(0, decode.string)
    decode.success(QueryRow(name:))
  }

  "
with squirrel_user as (select 1 as squirrel_user_id, 'Louis' as name)
select name
from squirrel_user
where $1 = squirrel_user_id
and squirrel_user.name = $2
"
  |> pog.query
  |> pog.parameter(pog.int(squirrel_user_id))
  |> pog.parameter(pog.text(squirrel_user_name))
  |> pog.returning(decoder)
  |> pog.execute(connection)
}

