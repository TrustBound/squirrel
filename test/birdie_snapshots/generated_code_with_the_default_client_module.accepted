import gleam/dynamic/decode
import gleam/option.{type Option}
import pog

/// A row you get from running the `query` query
/// defined in `query.sql`.
///
/// > 🐿️ This type definition was generated automatically using v-test of the
/// > [squirrel package](https://github.com/giacomocavalieri/squirrel).
///
pub type QueryRow {
  QueryRow(name: String, acorns: Option(Int))
}

/// Runs the `query` query
/// defined in `query.sql`.
///
/// > 🐿️ This function was generated automatically using v-test of
/// > the [squirrel package](https://github.com/giacomocavalieri/squirrel).
///
pub fn query(
  db: pog.Connection,
  name: String,
) -> Result(pog.Returned(QueryRow), pog.QueryError) {
  let decoder = {
    use name <- decode.field(0, decode.string)
    use acorns <- decode.field(1, decode.optional(decode.int))
    decode.success(QueryRow(name:, acorns:))
  }

  "select name, acorns from squirrel where name = $1"
  |> pog.query
  |> pog.parameter(pog.text(name))
  |> pog.returning(decoder)
  |> pog.execute(db)
}

