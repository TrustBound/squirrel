import gleam/dynamic/decode
import pog

/// A row you get from running the `query` query
/// defined in `query.sql`.
///
/// > 🐿️ This type definition was generated automatically using v-test of the
/// > [dream_squirrel package](https://github.com/TrustBound/squirrel/tree/dream-squirrel),
/// > a fork of Squirrel.
///
pub type QueryRow {
  QueryRow(res: Bool)
}

/// This is a comment
/// that goes over multiple lines!
///
/// > 🐿️ This function was generated automatically using v-test of
/// > the [dream_squirrel package](https://github.com/TrustBound/squirrel/tree/dream-squirrel),
/// > a fork of Squirrel.
///
pub fn query(
  connection: pog.Connection,
) -> Result(pog.Returned(QueryRow), pog.QueryError) {
  let decoder = {
    use res <- decode.field(0, decode.bool)
    decode.success(QueryRow(res:))
  }

  "
-- This is a comment
-- that goes over multiple lines!
select true as res
"
  |> pog.query
  |> pog.returning(decoder)
  |> pog.execute(connection)
}

