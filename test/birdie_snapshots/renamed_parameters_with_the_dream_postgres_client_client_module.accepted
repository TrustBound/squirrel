import dream_postgres_client as pog
import gleam/dynamic/decode
import youid/uuid.{type Uuid}

/// A row you get from running the `query` query
/// defined in `query.sql`.
///
/// > 🐿️ This type definition was generated automatically using v-test of the
/// > [dream_sql_generator package](https://github.com/TrustBound/squirrel/tree/dream-sql-generator),
/// > a fork of Squirrel.
///
pub type QueryRow {
  QueryRow(uuid_decoder: Uuid)
}

/// Runs the `query` query
/// defined in `query.sql`.
///
/// > 🐿️ This function was generated automatically using v-test of
/// > the [dream_sql_generator package](https://github.com/TrustBound/squirrel/tree/dream-sql-generator),
/// > a fork of Squirrel.
///
pub fn query(
  connection: pog.Connection,
  uuid_decoder_1: Uuid,
  connection_1: Int,
) -> Result(pog.Returned(QueryRow), pog.QueryError) {
  let decoder = {
    use uuid_decoder <- decode.field(0, uuid_decoder())
    decode.success(QueryRow(uuid_decoder:))
  }

  "
with wibble as (select gen_random_uuid() as uuid_decoder, 1 as connection)
select uuid_decoder
from wibble
where $1 = uuid_decoder
and connection = $2
"
  |> pog.query
  |> pog.parameter(pog.text(uuid.to_string(uuid_decoder_1)))
  |> pog.parameter(pog.int(connection_1))
  |> pog.returning(decoder)
  |> pog.execute(connection)
}

// --- Encoding/decoding utils -------------------------------------------------

/// A decoder to decode `Uuid`s coming from a Postgres query.
///
fn uuid_decoder() {
  use bit_array <- decode.then(decode.bit_array)
  case uuid.from_bit_array(bit_array) {
    Ok(uuid) -> decode.success(uuid)
    Error(_) -> decode.failure(uuid.v7(), "Uuid")
  }
}

